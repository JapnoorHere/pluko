# Local service address. Set both values together.
PORT=4180
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:4180

# Keep SQLite on local persistent storage. Do not use an SMB/NFS/shared volume.
DATA_DIR=./data

# Image source used by the worker. "bing" reads Bing's public image-search page, which can be blocked or restricted by Bing's terms;
# review that before relying on it. "mock" is an offline test source and is refused when NODE_ENV=production.
# PLUKO_PROVIDER=bing
# "brave" uses the Brave Search API with your own key (https://brave.com/search/api/). It returns one batch of up to 200 results per query
# and ignores the image type, shape, size and colour filters. Not yet verified against the live API.
# PLUKO_PROVIDER=brave
# BRAVE_API_KEY=

# For production only: NODE_ENV=production, HTTPS PUBLIC_ORIGIN, and a 64-character random hex encryption key.
# Generate the key outside Pluko and store it in your secret manager; do not commit it.
# NODE_ENV=production
# ENCRYPTION_KEY=
# TRUST_PROXY=true # Enable only when the app is reachable exclusively through Caddy/Nginx.
