# Local service address. Set both values together.
PORT=4180
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:4180

# Keep SQLite on local persistent storage. Do not use an SMB/NFS/shared volume.
DATA_DIR=./data

# For production only: NODE_ENV=production, HTTPS PUBLIC_ORIGIN, and a 64-character random hex encryption key.
# Generate the key outside Pluko and store it in your secret manager; do not commit it.
# NODE_ENV=production
# ENCRYPTION_KEY=
# TRUST_PROXY=true # Enable only when the app is reachable exclusively through Caddy/Nginx.
