# Public DNS name. Create an A record to this server before startup.
PLUKO_DOMAIN=images.example.com
PUBLIC_ORIGIN=https://images.example.com

# Generate once with: openssl rand -hex 32
# Save this only in the server's deploy/.env file or a secret manager.
ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Port published on 127.0.0.1 for a reverse proxy running on the host (default 4180).
# API_PORT=4180

# Image source: bing (default, reads Bing's public page; review its terms) or brave (needs BRAVE_API_KEY).
# PLUKO_PROVIDER=bing
# BRAVE_API_KEY=
